# Variables de entorno del backend.
# Copia este archivo como backend/.env y reemplaza los valores de ejemplo.
# Nunca subas el archivo .env al repositorio.

# --- Aplicación -------------------------------------------------------------
# Valores permitidos: development, test, production
APP_ENV=development
APP_NAME="Sistema de Nómina Docente"
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Institución ------------------------------------------------------------
INSTITUTION_NAME="Tecnológico de Estudios Superiores de Huixquilucan"
INSTITUTION_SHORT_NAME=TESH

# --- Base de datos ----------------------------------------------------------
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://nomina_app:cambia-esta-contrasena@localhost:5432/nomina_docente
DATABASE_URL_TEST=postgresql+psycopg://nomina_app:cambia-esta-contrasena@localhost:5432/nomina_docente_test

# --- Autenticación ----------------------------------------------------------
# Obligatorio, mínimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplaza-con-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=nomina_session
CSRF_COOKIE_NAME=nomina_csrf
# true cuando el sistema se sirva por HTTPS; false solo en desarrollo local por HTTP
AUTH_COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Orígenes permitidos separados por comas
CORS_ORIGINS=http://localhost:3000

# --- Nómina -----------------------------------------------------------------
# Prefijo del folio del recibo (ej. NOM-202610-Q2-000042)
PAYROLL_FOLIO_PREFIX=NOM
