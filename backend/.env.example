# Variables de entorno del backend.
# Copia este archivo como backend/.env (scripts/setup.sh lo hace por ti) y reemplaza
# los valores de ejemplo. Nunca subas el archivo .env al repositorio.
# Todas las variables son obligatorias: si falta una, el backend no inicia. Los valores de
# este archivo son los recomendados (seguros) salvo los marcados como ejemplo.

# --- Aplicación -------------------------------------------------------------
# Valores permitidos: development, test, production
APP_ENV=development
APP_NAME="Sistema de Nómina Docente"
API_HOST=127.0.0.1
API_PORT=8000
# Valores permitidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Institución ------------------------------------------------------------
INSTITUTION_NAME="Tecnológico de Estudios Superiores de Huixquilucan"
INSTITUTION_SHORT_NAME=TESH

# --- Base de datos ----------------------------------------------------------
# También las usa scripts/create-databases.sh para crear las bases locales.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=nomina_docente
DB_NAME_TEST=nomina_docente_test

# --- Tokens de sesión (docs/seguridad.md) -----------------------------------
# Obligatorio, mínimo 32 caracteres (valor de ejemplo). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplaza-con-un-secreto-aleatorio-de-al-menos-32-caracteres
# Valores permitidos: HS256, HS384, HS512
JWT_ALGORITHM=HS256
# Vida del token de acceso (JWT). Corta: si se filtra, deja de servir pronto.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Vida del refresh token; se renueva (rota) en cada uso.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Segundos en los que reutilizar un refresh token recién rotado se trata como una carrera
# entre pestañas (se rechaza sin revocar). Pasado ese tiempo, el reuso revoca todas las
# sesiones del usuario. 0 desactiva la tolerancia.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# --- Cookies ----------------------------------------------------------------
# Deben ser distintos. En producción con HTTPS se recomienda el prefijo __Host- (p. ej.
# __Host-nomina_access), que obliga a Secure y Path=/ (no aplica a la de refresh).
ACCESS_COOKIE_NAME=nomina_access
REFRESH_COOKIE_NAME=nomina_refresh
# Indicador sin valor secreto que usa el proxy de Next.js para redirigir; debe coincidir con
# SESSION_HINT_COOKIE_NAME de frontend/.env.local
SESSION_HINT_COOKIE_NAME=nomina_session
# Debe coincidir con NEXT_PUBLIC_CSRF_COOKIE_NAME de frontend/.env.local
CSRF_COOKIE_NAME=nomina_csrf
# true cuando el sistema se sirva por HTTPS (obligatorio en producción); false solo en
# desarrollo local por HTTP
AUTH_COOKIE_SECURE=false
# Valores permitidos: lax, strict
AUTH_COOKIE_SAMESITE=lax

# --- Inicio de sesión y contraseñas -----------------------------------------
# Intentos fallidos seguidos antes de bloquear la cuenta, y minutos de bloqueo.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Longitud mínima de la contraseña (entre 8 y 128).
PASSWORD_MIN_LENGTH=12

# --- Peticiones -------------------------------------------------------------
# Tamaño máximo del cuerpo de una petición, en bytes (64 KiB).
MAX_REQUEST_BODY_BYTES=65536

# --- CORS -------------------------------------------------------------------
# Orígenes permitidos separados por comas. También se usan para validar el encabezado
# Origin de las peticiones que modifican datos (defensa adicional contra CSRF).
CORS_ORIGINS=http://localhost:3000

# --- Nómina -----------------------------------------------------------------
# Prefijo del folio del recibo (ej. NOM-202610-Q2-000042)
PAYROLL_FOLIO_PREFIX=NOM
# true: solo se emite el recibo de una quincena que ya terminó. false: también se puede
# emitir la quincena en curso (nunca una futura). Ver docs/reglas-de-negocio.md (RN-29).
PAYROLL_ISSUE_REQUIRES_CLOSED_PERIOD=true

# --- Horarios y bitácora ----------------------------------------------------
# Duración mínima y máxima de una clase (horario o sesión), en minutos.
CLASS_MIN_DURATION_MINUTES=30
CLASS_MAX_DURATION_MINUTES=300
# Antigüedad máxima, en días, de una sesión que se registra en la bitácora (0 = solo hoy).
LOGBOOK_MAX_AGE_DAYS=30
