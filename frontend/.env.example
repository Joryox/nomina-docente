# Variables de entorno del frontend.
# Copia este archivo como frontend/.env.local y reemplaza los valores de ejemplo.
# Las variables NEXT_PUBLIC_* se exponen al navegador: nunca pongas secretos en ellas.

# --- Aplicación -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Sistema de Nómina Docente"
NEXT_PUBLIC_INSTITUTION_NAME="Tecnológico de Estudios Superiores de Huixquilucan"
NEXT_PUBLIC_INSTITUTION_SHORT_NAME=TESH

# --- API --------------------------------------------------------------------
# Ruta base que usa el navegador; Next.js la reenvía al backend.
NEXT_PUBLIC_API_BASE_PATH=/api/v1
# Solo servidor: destino del proxy de Next.js (rewrites) hacia FastAPI.
API_PROXY_TARGET=http://127.0.0.1:8000
