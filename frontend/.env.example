# Variables de entorno del frontend.
# Copia este archivo como frontend/.env.local (scripts/setup.sh lo hace por ti) y
# reemplaza los valores de ejemplo. Todas son obligatorias: si falta una, la app no inicia.
# Las variables NEXT_PUBLIC_* se incrustan en el código del navegador al compilar:
# nunca pongas secretos en ellas.

# --- Aplicación -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Sistema de Nómina Docente"
NEXT_PUBLIC_INSTITUTION_NAME="Tecnológico de Estudios Superiores de Huixquilucan"
NEXT_PUBLIC_INSTITUTION_SHORT_NAME=TESH

# --- API --------------------------------------------------------------------
# Ruta base que usa el navegador; Next.js la reenvía al backend (sin / final).
NEXT_PUBLIC_API_BASE_PATH=/api/v1
# Debe coincidir con CSRF_COOKIE_NAME de backend/.env
NEXT_PUBLIC_CSRF_COOKIE_NAME=nomina_csrf
# Solo servidor: destino del proxy de Next.js (rewrites) hacia FastAPI (sin / final).
API_PROXY_TARGET=http://127.0.0.1:8000

# --- Desarrollo -------------------------------------------------------------
# Puerto del servidor de desarrollo; lo usa scripts/dev.sh. Debe estar en CORS_ORIGINS.
DEV_SERVER_PORT=3000
